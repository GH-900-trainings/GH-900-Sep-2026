# Copy this file to .env and fill in the values. Never commit .env.

# Required. Azure portal -> your Azure Maps account -> Authentication -> Primary Key.
# The server refuses to start when this is empty.
AZURE_MAPS_KEY=

# Optional. Defaults shown.
PORT=3000
AZURE_MAPS_BASE_URL=https://atlas.microsoft.com
AZURE_MAPS_GEOCODE_API_VERSION=2025-01-01
AZURE_MAPS_WEATHER_API_VERSION=1.1
WEATHER_UNITS=metric
HTTP_TIMEOUT_MS=8000
